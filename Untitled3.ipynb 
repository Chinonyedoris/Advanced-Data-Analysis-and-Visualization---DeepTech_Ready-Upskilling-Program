        "## Group by Relevant_Experience\n",
        "\n",
        "### Subtask:\n",
        "Group the data by 'Relevant_Experience' and calculate the average 'City_Development_Index' for each group.\n"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "f99698fb",
        "outputId": "fac82dcf-7c4b-496e-9558-5a1c6b68f9a6"
      },
      "source": [
        "df['experience_numeric'] = df['experience'].replace({'<1': '0', '>20': '21'}).astype(str)\n",
        "df['experience_numeric'] = pd.to_numeric(df['experience_numeric'], errors='coerce')\n",
        "\n",
        "experience_city_development_index_mean = df.groupby('relevent_experience')['city_development_index'].mean()\n",
        "\n",
        "print(\"Average 'City_Development_Index' by 'Relevant_Experience':\")\n",
        "print(experience_city_development_index_mean)"
